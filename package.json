{
  "name": "ocsjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent browser study and exercise assistant with six platform adapters and no runtime dependencies.",
  "license": "GPL-3.0-or-later",
  "author": "NeonTideX",
  "repository": { "type": "git", "url": "git+https://github.com/NeonTideX/OCSJS.git" },
  "homepage": "https://github.com/NeonTideX/OCSJS#readme",
  "bugs": { "url": "https://github.com/NeonTideX/OCSJS/issues" },
  "keywords": ["userscript", "study", "courseware", "typescript", "browser"],
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "node scripts/audit.mjs",
    "tsc": "tsc --noEmit",
    "test": "tsx --test --test-reporter=dot tests/answers.test.ts tests/core.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "check": "pnpm lint && pnpm tsc && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
